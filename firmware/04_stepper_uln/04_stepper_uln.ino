/*
 * AutoRack — тест 04: мотор каретки 28BYJ-48 + драйвер ULN2003
 * ------------------------------------------------------------
 * Цель: убедиться, что ESP32 через ULN2003 крутит 28BYJ-48:
 *       направление, скорость, плавность.
 *
 * Подключение:
 *   ULN2003 модуль:
 *     IN1 -> GPIO32
 *     IN2 -> GPIO33
 *     IN3 -> GPIO25
 *     IN4 -> GPIO26
 *     VCC -> +5В   (ОТДЕЛЬНЫЙ источник >=1А, общий GND с ESP32!)
 *     GND -> GND
 *     5-pin разъём -> 28BYJ-48
 *
 * ПИТАНИЕ:
 *   - 28BYJ-48 под нагрузкой тянет до ~200 мА (пиками больше).
 *   - USB-порт ноутбука может просесть -> лучше USB-адаптер/повербанк >=1А.
 *   - GND ULN2003 и ESP32 ОБЯЗАТЕЛЬНО соединить вместе.
 *
 * 28BYJ-48 технически:
 *   - шаговый, 4-фазный, редуктор ~1:64.
 *   - внутренних "шагов" на оборот вала выхода ~2048 (в полношаге).
 *   - используем библиотеку Stepper (встроена в Arduino IDE).
 *
 * Что делает скетч:
 *   1. Крутит вал вперёд (2 оборота), пауза.
 *   2. Крутит назад (2 оборота), пауза.
 *   3. Повторяет. В Serial сообщает, что происходит.
 *
 * Serial Monitor: 115200.
 */

#include <Stepper.h>

// Пины ULN2003, порядок важен: IN1, IN2, IN3, IN4
#define IN1 32
#define IN2 33
#define IN3 25
#define IN4 26

// Шагов на оборот вала выхода (с редуктором).
// Для 28BYJ-48 обычно 2048 в полношаговом режиме.
// Если мотор крутится не синхронно/дёргается — попробуй 2038.
#define STEPS_PER_REV 2048

Stepper motor(STEPS_PER_REV, IN1, IN3, IN2, IN4);

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("=========================================");
  Serial.println(" AutoRack — тест 04: 28BYJ-48 + ULN2003");
  Serial.println("-----------------------------------------");
  Serial.println(" IN1=GPIO32 IN2=GPIO33 IN3=GPIO25 IN4=GPIO26");
  Serial.println(" VCC=+5В (внешний >=1А), GND общий с ESP32");
  Serial.println("=========================================");
  Serial.println();

  // Скорость (об/мин). 28BYJ-48 стабильно крутится ~10-15 RPM.
  // Начнём с медленной скорости для наглядности.
  motor.setSpeed(10);
}

void loop() {
  Serial.println(">> Вперёд (2 оборота)...");
  motor.step(STEPS_PER_REV * 2);
  delay(1000);

  Serial.println("<< Назад (2 оборота)...");
  motor.step(-STEPS_PER_REV * 2);
  delay(1000);

  // ---- Тест скорости: одна и та же дистанция на разных скоростях ----
  Serial.println(">> Тест скорости: медленно (5 RPM)...");
  motor.setSpeed(5);
  motor.step(STEPS_PER_REV);
  delay(500);

  Serial.println(">> Тест скорости: быстро (15 RPM)...");
  motor.setSpeed(15);
  motor.step(STEPS_PER_REV);
  delay(500);

  // Сброс на медленную скорость для следующего цикла.
  motor.setSpeed(10);
  Serial.println("Цикл завершён, повтор через 2 сек.\n");
  delay(2000);
}
